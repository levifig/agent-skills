# Dependencies
node_modules/

# Build output (committed by CI)
# dist/ - tracked (for OpenCode, Cursor, Codex, Amp)
# plugins/ - tracked (for Claude Code marketplace)
# .claude-plugin/ - tracked (for Claude Code marketplace)

# CLI build output. The launcher and native binaries under bin/ are generated
# by `npm run build:go`. No native binary is tracked; the Claude Code plugin
# ships a shell shim that resolves an installed loaf.
dist-cli/
/bin/
!plugins/loaf/dist-cli/
!plugins/loaf/dist-cli/**

# Temporary backups
dist-backup/
plugins-backup/
dist/release/

# OS files
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Claude Code ephemeral plans
.claude/
!.claude/CLAUDE.md

# Agent work — track everything except ephemeral state
.agents/transcripts/
.agents/.loaf-state
.agents/.moved-to
.agents/tmp/

# Environment files
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Package manager locks: Loaf has no JavaScript dependencies
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Stakpak session files
.stakpak/session*
