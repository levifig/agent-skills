        "summary",
        "evidence",
        "status_intent",
        "blockers",
        "next_step"
      ]
    }
  ],
  "agents": [
    {
      "name": "project-manager",
      "path": "agents/project-manager.md",
      "contract_path": "agents/project-manager.contract.json"
